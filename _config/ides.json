{
  "version": "1.0.0",
  "ides": [
    {
      "id": "kiro",
      "name": "Kiro",
      "capabilities": ["steering", "skill", "workflow", "prompt", "agent"],
      "global_paths": {
        "steering": "~/.kiro/steering/{id}.md"
      },
      "workspace_paths": {
        "steering": ".kiro/steering/{id}.md",
        "skill": ".kiro/skills/{id}.md",
        "workflow": ".kiro/steering/{id}.md",
        "prompt": ".kiro/steering/{id}.md",
        "agent": ".kiro/steering/{id}.md"
      },
      "special_behaviors": {}
    },
    {
      "id": "github-copilot",
      "name": "GitHub Copilot",
      "capabilities": ["steering", "skill", "prompt"],
      "global_paths": {},
      "workspace_paths": {
        "steering": ".github/copilot-instructions.md",
        "skill": ".github/prompts/{id}.prompt.md",
        "prompt": ".github/prompts/{id}.prompt.md"
      },
      "special_behaviors": {
        "steering": "concatenate_all"
      }
    },
    {
