        "steering": "~/.aws/amazonq/rules/{id}.md"
      },
      "workspace_paths": {
        "steering": ".amazonq/rules/{id}.md",
        "skill": ".amazonq/rules/{id}.md",
        "agent": ".amazonq/rules/{id}.md"
      },
      "special_behaviors": {}
    },
    {
      "id": "claude-code",
      "name": "Claude Code",
      "capabilities": ["steering", "skill", "workflow"],
      "global_paths": {
        "steering": "~/.claude/CLAUDE.md"
