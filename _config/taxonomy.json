{
  "version": "1.0.0",
  "chapters": {
    "backend": {
      "platforms": {
        "java": {
          "stacks": [
            "java-spring",
            "java-webflux"
          ],
          "detection": {
            "java-spring": {
              "signals": [
                "pom.xml",
                "build.gradle"
              ],
              "excludes_signal": {
                "file": "AndroidManifest.xml"
              }
            },
            "java-webflux": {
              "signals": [
                "pom.xml"
              ],
              "requires_signal": {
                "file": "pom.xml",
                "contains": "spring-boot-starter-webflux"
              }
            }
          }
        },
        "node": {
          "stacks": [
            "node-express",
            "node-lambda"
          ],
          "detection": {
            "node-express": {
              "signals": [
                "package.json"
              ],
              "excludes_signal": {
                "file": "nest-cli.json"
              }
            },
            "node-lambda": {
              "signals": [
                "package.json",
                "serverless.yml"
              ]
            }
          }
        },
        "dotnet": {
          "stacks": [
            "dotnet"
          ],
          "detection": {
            "dotnet": {
              "signals": [
                "*.csproj",
                "*.sln"
              ]
            }
          }
        }
      }
    },
    "calidad": {
      "platforms": {
        "automation": {
          "stacks": [
            "karate",
            "playwright",
            "k6",
            "appium-serenity",
            "appium-core",
            "appium-wdio"
          ],
          "detection": {
            "karate": {
              "signals": [
                "karate-config.js"
              ]
            },
            "playwright": {
              "signals": [
                "playwright.config.ts",
                "playwright.config.js",
                "package.json"
              ],
              "requires_signal": {
                "file": "package.json",
                "contains": "playwright"
              }
            },
            "k6": {
              "signals": [
                "package.json"
              ],
              "requires_signal": {
                "file": "package.json",
                "contains": "k6 run"
              }
            },
            "appium-wdio": {
              "signals": [
                "package.json"
              ],
              "requires_signal": {
                "file": "package.json",
                "contains": "webdriverio"
              }
            },
            "appium-serenity": {
              "signals": [
                "build.gradle"
              ],
              "requires_signal": {
                "file": "build.gradle",
                "contains": "appium-java-client"
              }
            },
            "appium-core": {
              "signals": [
                "package.json",
                "build.gradle"
              ],
              "note": "companion: se instala junto a appium-serenity o appium-wdio, no se detecta solo"
            }
          }
        }
      }
    },
    "mobile": {
      "platforms": {
        "flutter": {
          "stacks": [
            "flutter"
          ],
          "detection": {
            "flutter": {
              "signals": [
                "pubspec.yaml"
              ]
            }
          }
        },
        "android": {
          "stacks": [
            "android-native"
          ],
          "detection": {
            "android-native": {
              "signals": [
                "build.gradle",
                "AndroidManifest.xml"
              ]
            }
          }
        },
        "apple": {
          "stacks": [
            "apple-native"
          ],
          "detection": {
            "apple-native": {
              "signals": [
                "*.xcodeproj",
                "Package.swift"
              ]
            }
          }
        }
      }
    },
    "frontend": {
      "platforms": {
        "react": {
          "stacks": [
            "react"
          ],
          "detection": {
            "react": {
              "signals": [
                "package.json"
              ],
              "requires_signal": {
                "file": "package.json",
                "contains": "react"
              }
            }
          }
        },
        "angular": {
          "stacks": [
            "angular"
          ],
          "detection": {
            "angular": {
              "signals": [
                "angular.json"
              ]
            }
          }
        }
      }
    },
    "arquitectura": {
      "platforms": {}
    }
  }
}
