  "scopes": {
    "global": {
      "requires_chapter": false,
      "requires_stack": false,
      "requires_project": false,
      "folder": "shared/"
    },
    "chapter": {
      "requires_chapter": true,
      "requires_stack": false,
      "requires_project": false,
      "folder": "chapters/{chapter}/"
    },
    "stack": {
      "requires_chapter": true,
      "requires_stack": true,
      "requires_project": false,
      "folder": "chapters/{chapter}/skills/{stack}/"
    },
    "project": {
      "requires_chapter": true,
      "requires_stack": false,
      "requires_project": true,
      "requires_account": true,
      "folder": "accounts/{account}/{chapter}/{project}/",
      "note": "Aplica a UN proyecto de la cuenta. El campo `project` del frontmatter lo nombra."
    },
    "account": {
      "requires_chapter": true,
      "requires_stack": false,
      "requires_project": false,
      "requires_account": true,
      "folder": "accounts/{account}/{chapter}/_cuenta/",
      "note": "Aplica a TODOS los proyectos de la cuenta. Se sincroniza a cada proyecto."
    }
  },
  "valid_chapters": [
    "backend",
    "calidad",
    "mobile",
    "frontend",
    "arquitectura"
  ],
  "override_fields": {
    "pragma_extends": "Path en core del asset que extiende",
    "pragma_override": "full | merge"
  },
  "valid_accounts": [
    "mercantil"
  ],
  "accounts": {
    "mercantil": {
      "projects": [
        "pn",
        "pj"
      ]
    }
  }
}
