        </mxCell>

        <!-- API GW routes table -->
        <mxCell id="apigw-routes" value="POST /sync · GET /taxonomy · GET /config · GET /cli/version → ✅ Cognito JWT → sopp-hub-sync&lt;br&gt;GET /health → ❌ Pública → sopp-hub-sync&lt;br&gt;POST /webhook/github → ❌ HMAC propio → sopp-hub-webhook" style="text;html=1;strokeColor=#6c8ebf;fillColor=#EBF5FB;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="470" y="310" width="500" height="60" as="geometry" />
        </mxCell>

