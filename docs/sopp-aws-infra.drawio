        </mxCell>

        <mxCell id="iam-webhook" value="IAM Role — webhook&lt;br&gt;&lt;font size=&quot;10&quot;&gt;s3:GetObject, s3:PutObject, s3:ListBucket&lt;br&gt;secretsmanager:GetSecretValue (webhook-secret, github-api-token)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=10;arcSize=6;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1020" y="890" width="310" height="60" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════ -->
        <!-- EDGES / ARROWS                              -->
        <!-- ═══════════════════════════════════════════ -->

        <!-- CLI → API Gateway -->
        <mxCell id="e1" value="POST /sync&lt;br&gt;Bearer {jwt}" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" source="ext-cli" target="apigw" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- GitHub → API Gateway (webhook) -->
        <mxCell id="e2" value="POST /webhook/github&lt;br&gt;X-Hub-Signature-256" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="ext-github" target="apigw" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Cognito → API Gateway -->
        <mxCell id="e3" value="Valida JWT" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0;entryDx=0;entryDy=0;" edge="1" source="ext-cognito" target="apigw" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- API Gateway → Lambda Sync -->
        <mxCell id="e4" value="Rutas autenticadas" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="apigw" target="lambda-sync" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- API Gateway → Lambda Webhook -->
        <mxCell id="e5" value="/webhook/github" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="apigw" target="lambda-webhook" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Lambda Sync → S3 (read) -->
        <mxCell id="e6" value="GetObject · ListBucket" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;" edge="1" source="lambda-sync" target="s3" parent="1">
