        <!-- ═══════════════════════════════════════════ -->

        <mxCell id="apigw" value="&lt;b&gt;API Gateway — sopp-hub-api&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;10&quot;&gt;JWT Authorizer (Cognito) en todas las rutas excepto /webhook/github y /health&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=6;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
