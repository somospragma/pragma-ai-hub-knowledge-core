        <mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;dashed=1;dashPattern=4 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=none;" edge="1" source="lambda-sync" target="iam-sync" parent="1">
