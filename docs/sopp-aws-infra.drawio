        <!-- Lambda Sync → Secrets Manager -->
        <mxCell id="e7" value="GetSecretValue&lt;br&gt;hub-signing-key" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="lambda-sync" target="sm" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Lambda Webhook → S3 (read/write) -->
        <mxCell id="e8" value="PutObject · GetObject" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" edge="1" source="lambda-webhook" target="s3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Lambda Webhook → Secrets Manager -->
        <mxCell id="e9" value="GetSecretValue&lt;br&gt;webhook-secret · github-api-token" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="lambda-webhook" target="sm" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Lambda Webhook → GitHub (API fetch, dashed) -->
        <mxCell id="e10" value="GET /repos/{owner}/{repo}/contents/{path}&lt;br&gt;Authorization: token" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;dashed=1;dashPattern=8 4;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;endArrow=open;endFill=0;" edge="1" source="lambda-webhook" target="ext-github" parent="1">
          <mxGeometry relative="1" as="geometry" />
