        <!-- ═══════════════════════════════════════════ -->

        <mxCell id="iam-sync" value="IAM Role — sync&lt;br&gt;&lt;font size=&quot;10&quot;&gt;s3:GetObject, s3:ListBucket&lt;br&gt;secretsmanager:GetSecretValue (hub-signing-key)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=10;arcSize=6;fontStyle=0;" vertex="1" parent="1">
