.DS_STORE
.DS_Store

# Conocimiento de cuenta: su sistema de registro es Mimir, no este repo
accounts/

# Salida de build de bundles y material de trabajo: no es dominio versionable
salida/
entrada/

# Tooling de migracion: los scripts y el README se versionan.
# El estado operativo y los reportes no: cambian en cada corrida y son regenerables.
migration/sync-state*.json
migration/id-map.json
migration/report*.json

__pycache__/
*.pyc
